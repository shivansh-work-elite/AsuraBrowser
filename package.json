{
  "name": "asura-browser",
  "version": "1.0.0",
  "description": "AsuraBrowser \u2014 persistent AI-assisted browser",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && electron .",
    "dev": "concurrently \"tsc -w\" \"wait-on dist/main/main.js && electron .\"",
    "package": "npm run build && electron-builder"
  },
  "keywords": [
    "browser",
    "pentesting",
    "security",
    "electron"
  ],
  "author": "EliteAsura",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "concurrently": "^8.0.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "typescript": "^5.3.0",
    "wait-on": "^7.0.0"
  },
  "build": {
    "appId": "com.eliteshibb.asurabrowser",
    "productName": "AsuraBrowser",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/renderer/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    }
  }
}
